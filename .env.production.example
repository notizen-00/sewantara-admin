# URL API harus dapat diakses dari browser pengguna.
NUXT_PUBLIC_API_BASE=https://api.example.com/api

# Endpoint backend yang memulai alur OAuth Google (redirect).
NUXT_PUBLIC_GOOGLE_AUTH_URL=https://api.example.com/api/central/auth/google/redirect

# Port lokal VPS yang diteruskan oleh Nginx.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3005

TZ=Asia/Jakarta
